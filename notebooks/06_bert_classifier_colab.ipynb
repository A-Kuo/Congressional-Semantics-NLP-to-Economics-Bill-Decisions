   "source": [
    "# 06: BERT Fine-tuning (Google Colab Version) — GPU Required\n",
    "\n",
    "**⚠️ IMPORTANT:** This notebook is designed for **Google Colab with GPU enabled**.\n",
    "\n",
    "**Setup (required for Colab):**\n",
    "1. Open in Google Colab: https://colab.research.google.com\n",
    "2. Upload this notebook\n",
    "3. Runtime → Change runtime type → GPU\n",
    "4. Upload `bills_speeches_merged.csv` to Colab or use drive.mount()\n",
    "\n",
    "**Status:** OPTIONAL. Core research questions are answered without this.\n",
    "\n",
    "**Question this notebook answers:**  \n",
    "Does semantic context (BERT) improve predictions over bag-of-words (TF-IDF)?"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Setup: GPU Check & Colab Mounting"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Check GPU\n",
    "import torch\n",
    "print(f\"PyTorch version: {torch.__version__}\")\n",
    "print(f\"GPU available: {torch.cuda.is_available()}\")\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    print(f\"GPU device: {torch.cuda.get_device_name(0)}\")\n",
    "    print(f\"GPU memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB\")\nelse:\n",
    "    print(\"⚠️ WARNING: No GPU detected!\")\n",
    "    print(\"Please set runtime to GPU: Runtime → Change runtime type → GPU\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Mount Google Drive (for data access)\n",
    "try:\n",
    "    from google.colab import drive\n",
    "    drive.mount(\"/content/drive\")\n",
    "    print(\"✓ Google Drive mounted\")\n",
    "    COLAB_MODE = True\nexcept ImportError:\n",
    "    print(\"Not running on Colab. Assuming local file access.\")\n",
    "    COLAB_MODE = False"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Install required packages (Colab has most pre-installed)\n",
    "import subprocess\n",
    "import sys\n",
    "\n",
    "# Install specific versions\n",
    "subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"transformers==4.35.0\"])\nsubprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", \"datasets==2.14.0\"])\n\nprint(\"✓ Dependencies installed\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "from sklearn.model_selection import train_test_split\n",
    "\n",
    "SEED = 42\n",
    "np.random.seed(SEED)\n",
    "torch.manual_seed(SEED)\n",
    "\n",
    "# Determine file path based on environment\n",
    "if COLAB_MODE:\n",
    "    # Try to find in Google Drive\n",
    "    data_path = \"/content/drive/My Drive/Congressional_NLP/data/processed/bills_speeches_preprocessed.csv\"\n",
    "    if not os.path.exists(data_path):\n",
    "        print(\"⚠️ File not found in Google Drive\")\n",
    "        print(\"Alternative: Upload CSV directly or adjust path\")\n",
    "        data_path = \"/content/bills_speeches_preprocessed.csv\"\nelse:\n",
    "    data_path = \"../data/processed/bills_speeches_preprocessed.csv\"\n",
    "\n",
    "import os\n",
    "if os.path.exists(data_path):\n",
    "    df = pd.read_csv(data_path)\n",
    "    print(f\"✓ Loaded {len(df)} bills from {data_path}\")\nelse:\n",
    "    print(f\"ERROR: Data file not found at {data_path}\")\n",
    "    print(\"Please ensure bills_speeches_preprocessed.csv is available\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Prepare Text Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Use bill title + summary (shorter than full speech, fits in BERT's 512 token limit)\n",
    "df[\"text_input\"] = df[\"title\"].fillna(\"\") + \" \" + df[\"summary\"].fillna(\"\")\n",
    "\n",
    "# Validation\n",
    "assert df[\"text_input\"].isnull().sum() == 0, \"Null text values\"\nprint(f\"✓ Text input created: {len(df)} samples\")\n\n",
    "# Check length distribution\n",
    "text_lengths = df[\"text_input\"].str.split().str.len()\n",
    "print(f\"\\nText length (words):\")\n",
    "print(f\"  Min: {text_lengths.min()}\")\n",
    "print(f\"  Max: {text_lengths.max()}\")\n",
    "print(f\"  Mean: {text_lengths.mean():.0f}\")\n",
    "print(f\"  Median: {text_lengths.median():.0f}\")\n",
    "print(f\"  95th percentile: {text_lengths.quantile(0.95):.0f}\")\n",
    "\nif text_lengths.quantile(0.95) > 500:\n",
    "    print(f\"\\n⚠️ Warning: Many texts exceed 512 token limit (will be truncated)\")\nelse:\n",
    "    print(f\"\\n✓ Most texts fit in BERT's token limit\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Train/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Stratified split\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    df[\"text_input\"].values,\n",
    "    df[\"passed\"].values,\n",
    "    test_size=0.2,\n",
    "    random_state=SEED,\n",
    "    stratify=df[\"passed\"].values\n",
    ")\n",
    "\n",
    "print(f\"✓ Train/test split:\")\n",
    "print(f\"  Train: {len(X_train)} samples\")\n",
    "print(f\"  Test: {len(X_test)} samples\")\n",
    "print(f\"  Train pass rate: {y_train.mean():.1%}\")\n",
    "print(f\"  Test pass rate: {y_test.mean():.1%}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Load BERT & Tokenizer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from transformers import (\n",
    "    DistilBertForSequenceClassification,\n",
    "    DistilBertTokenizer,\n",
    "    Trainer,\n",
    "    TrainingArguments,\n",
    ")\nfrom datasets import Dataset\n",
    "\n",
    "# Use DistilBERT (faster than BERT)\n",
    "model_name = \"distilbert-base-uncased\"\n",
    "tokenizer = DistilBertTokenizer.from_pretrained(model_name)\n",
    "model = DistilBertForSequenceClassification.from_pretrained(model_name, num_labels=2)\n",
    "\n",
    "print(f\"✓ Loaded {model_name}\")\n",
    "print(f\"  Model parameters: {model.num_parameters():,}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Tokenize Datasets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def tokenize_function(examples):\n",
    "    return tokenizer(\n",
    "        examples[\"text\"],\n",
    "        padding=\"max_length\",\n",
    "        truncation=True,\n",
    "        max_length=512\n",
    "    )\n",
    "\n",
    "# Create HuggingFace datasets\n",
    "train_dataset = Dataset.from_dict({\n",
    "    \"text\": X_train.tolist(),\n",
    "    \"label\": y_train.tolist()\n",
    "})\n",
    "\n",
    "test_dataset = Dataset.from_dict({\n",
    "    \"text\": X_test.tolist(),\n",
    "    \"label\": y_test.tolist()\n",
    "})\n",
    "\n",
    "print(\"Tokenizing datasets (this may take a few minutes)...\")\n",
    "train_dataset = train_dataset.map(tokenize_function, batched=True, remove_columns=[\"text\"])\n",
    "test_dataset = test_dataset.map(tokenize_function, batched=True, remove_columns=[\"text\"])\n",
    "\n",
    "print(f\"✓ Tokenization complete\")\n",
    "print(f\"  Train: {len(train_dataset)} samples\")\n",
    "print(f\"  Test: {len(test_dataset)} samples\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Training Setup & Hyperparameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "from sklearn.metrics import accuracy_score, roc_auc_score, f1_score\n",
    "\n",
    "def compute_metrics(eval_pred):\n",
    "    predictions, labels = eval_pred\n",
    "    predictions = np.argmax(predictions, axis=1)\n",
    "    return {\n",
    "        \"accuracy\": accuracy_score(labels, predictions),\n",
    "        \"auc\": roc_auc_score(labels, predictions),\n",
    "        \"f1\": f1_score(labels, predictions),\n",
    "    }\n",
    "\n",
    "# Training arguments\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./bert_checkpoint\",\n",
    "    num_train_epochs=3,\n",
    "    per_device_train_batch_size=16,\n",
    "    per_device_eval_batch_size=32,\n",
    "    learning_rate=2e-5,\n",
    "    weight_decay=0.01,\n",
    "    warmup_steps=100,\n",
    "    logging_steps=50,\n",
    "    evaluation_strategy=\"epoch\",\n",
    "    save_strategy=\"epoch\",\n",
    "    load_best_model_at_end=True,\n",
    "    metric_for_best_model=\"accuracy\",\n",
    "    seed=SEED,\n",
    "    disable_tqdm=False,\n",
    ")\n",
    "\n",
    "print(\"✓ Training configuration:\")\n",
    "print(f\"  Epochs: {training_args.num_train_epochs}\")\n",
    "print(f\"  Batch size: {training_args.per_device_train_batch_size}\")\n",
    "print(f\"  Learning rate: {training_args.learning_rate}\")\n",
    "print(f\"  Warmup steps: {training_args.warmup_steps}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Train BERT"
   ]
  },
  {
   "cell_type": {"text/plain": "code"},
    "execution_count": null,
    "metadata": {},
    "source": [
     "trainer = Trainer(\n",
     "    model=model,\n",
     "    args=training_args,\n",
     "    train_dataset=train_dataset,\n",
     "    eval_dataset=test_dataset,\n",
     "    compute_metrics=compute_metrics,\n",
     ")\n",
     "\n",
     "print(\"Starting training (this will take 10-30 minutes on GPU)...\")\n",
     "trainer.train()\n",
     "print(\"✓ Training complete\")"
    ]
   },
   {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
     "## Evaluate on Test Set"
    ]
   },
   {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "source": [
     "test_results = trainer.evaluate(test_dataset)\n",
     "print(\"\\n\" + \"=\"*60)\n",
     "print(\"BERT TEST RESULTS\")\n",
     "print(\"=\"*60)\n",
     "for key, value in test_results.items():\n",
     "    print(f\"{key}: {value:.4f}\")\n",
     "\n",
     "# Save results\n",
     "results_df = pd.DataFrame([test_results])\n",
     "results_df[\"model\"] = \"BERT (DistilBERT)\"\n",
     "results_df.to_csv(\"./bert_scores.csv\", index=False)\n",
     "print(\"\\n✓ Results saved to bert_scores.csv\")\n",
     "print(\"\\nDownload bert_scores.csv and move to results/tables/ in your local repo\")"
    ]
   },
   {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
     "## Comparison with TF-IDF Baseline"
    ]
   },
   {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "source": [
     "print(\"\\n\" + \"=\"*60)\n",
     "print(\"BERT vs TF-IDF COMPARISON\")\n",
     "print(\"=\"*60)\n",
     "\n",
     "bert_acc = test_results.get(\"eval_accuracy\", test_results.get(\"accuracy\", 0))\n",
     "logistic_acc = 0.65  # Placeholder: replace with actual baseline from notebook 03\n",
     "\n",
     "improvement = (bert_acc - logistic_acc) / logistic_acc * 100\n",
     "\n",
     "print(f\"\\nBERT accuracy: {bert_acc:.1%}\")\n",
     "print(f\"Logistic (baseline) accuracy: {logistic_acc:.1%}\")\n",
     "print(f\"Improvement: {improvement:+.1f}%\")\n",
     "\n",
     "if improvement > 5:\n",
     "    print(f\"\\n✓ BERT significantly outperforms TF-IDF\")\n",
     "    print(f\"  → Semantic context matters for predicting passage\")\n",
     "elif improvement > 0:\n",
     "    print(f\"\\n⚠ BERT slightly outperforms TF-IDF\")\n",
     "    print(f\"  → Marginal benefit from semantic context\")\n",
     "else:\n",
     "    print(f\"\\n✗ BERT does NOT outperform TF-IDF\")\n",
     "    print(f\"  → Bag-of-words features are sufficient\")\n",
     "    print(f\"  → Semantic context adds no predictive value\")"
    ]
   },
   {
    "cell_type": "markdown",
    "metadata": {},
    "source": [
     "## Summary for Report"
    ]
   },
   {
    "cell_type": "code",
    "execution_count": null,
    "metadata": {},
    "source": [
     "print(\"\\n\" + \"=\"*60)\n",
     "print(\"RESEARCH QUESTION ANSWER\")\n",
     "print(\"=\"*60)\n",
     "print(\"\\nQuestion: Does semantic context (BERT) improve predictions over TF-IDF?\")\n",
     "print(f\"\\nAnswer: {'YES' if improvement > 5 else 'NO' if improvement < 0 else 'MARGINAL'}\")\n",
     "print(f\"\\nEvidence:\")\n",
     "print(f\"  - BERT accuracy: {bert_acc:.1%}\")\n",
     "print(f\"  - TF-IDF baseline: {logistic_acc:.1%}\")\n",
     "print(f\"  - Improvement: {improvement:+.1f}%\")\n",
     "print(f\"\\nInterpretation:\")\n",
     "if improvement > 5:\n",
     "    print(f\"  BERT's contextual embeddings capture semantic patterns\")\n",
     "    print(f\"  beyond what bag-of-words (TF-IDF) can capture.\")\n",
     "elif improvement > 0:\n",
     "    print(f\"  While BERT performs slightly better, the improvement is\")\n",
     "    print(f\"  marginal, suggesting that word frequency (TF-IDF) captures\")\n",
     "    print(f\"  most of the predictive signal for bill passage.\")\n",
     "else:\n",
     "    print(f\"  BERT does not provide better predictions than TF-IDF.\")\n",
     "    print(f\"  This suggests that the specific words used (not their context)\")\n",
     "    print(f\"  are the primary signal for predicting bill passage.\")\n",
     "    print(f\"  The predictive power comes from word choice, not word meaning.\")"
    ]
   },
   {
